# Copie para .env e ajuste. É o endereço da MESMA API (Spring Boot) usada pelo site.
#
# Celular de verdade com Expo Go (mesma rede Wi-Fi do computador):
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:4000   <- troque pelo IP do computador (comando ipconfig)
# Emulador Android:        EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Simulador iOS / navegador: EXPO_PUBLIC_API_URL=http://localhost:4000
# API publicada no Render (depois que o código novo do backend for publicado):
#   EXPO_PUBLIC_API_URL=https://aquasite-server-1.onrender.com
EXPO_PUBLIC_API_URL=http://192.168.0.10:4000
